# MatrixOmnix Hub — env vars
#
# Copy to .env (or export in your shell) and customize.
# All of these are read by src/hub/config.ts at startup.

# ── Required ────────────────────────────────────────────────────────────
# Bearer token for /admin/* endpoints. Generate with: openssl rand -hex 16
HUB_ADMIN_TOKEN=

# ── Optional: where the SQLite file lives ──────────────────────────────
# HUB_DB_PATH=~/.matrixomnix/hub.db        # default

# ── Optional: bind address + port ──────────────────────────────────────
# HUB_PORT=3030                            # default
# HUB_BIND=127.0.0.1                       # default; use 0.0.0.0 for LAN

# ── Optional: weekly LLM learner pass ──────────────────────────────────
# Set both to enable Sunday 03:00 Opus pass over the last 7 days of findings.
# Without ANTHROPIC_API_KEY, the LLM pass is skipped silently.
# ANTHROPIC_API_KEY=
# HUB_DISABLE_LLM_LEARNER=1                # explicit kill switch

# ── Optional: disable specific learner rules ──────────────────────────
# Comma-separated rule IDs from R1..R5. Useful for muting noisy rules.
# HUB_DISABLE_RULE=R4
