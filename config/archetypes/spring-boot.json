{
  "id": "spring-boot",
  "name": "Java Spring Boot application",
  "description": "Spring Boot Java/Kotlin application",
  "recommended_standard": "generic-project",
  "applicable_qa_patterns": ["verification_failure/build_failed", "safety_failure/insecure_default", "safety_failure/secret_leak"],
  "risk_profile": "high",
  "threshold": 0.3,
  "signals": [
    { "type": "file_glob", "pattern": "pom.xml", "weight": 3, "label": "pom.xml" },
    { "type": "file_glob", "pattern": "build.gradle", "weight": 3, "label": "build.gradle" },
    { "type": "file_glob", "pattern": "build.gradle.kts", "weight": 3, "label": "build.gradle.kts" },
    { "type": "file_glob", "pattern": "**/SpringBootApplication.java", "weight": 4, "label": "SpringBootApplication" },
    { "type": "file_glob", "pattern": "**/src/main/java/**/*.java", "weight": 2, "label": "src/main/java/**" },
    { "type": "file_glob", "pattern": "**/application.properties", "weight": 2, "label": "application.properties" },
    { "type": "file_glob", "pattern": "**/application.yml", "weight": 2, "label": "application.yml" }
  ]
}
