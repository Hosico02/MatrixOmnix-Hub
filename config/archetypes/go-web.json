{
  "id": "go-web",
  "name": "Go web server (gin / echo / fiber / net/http)",
  "description": "Go HTTP server using gin, echo, fiber, chi, or net/http directly",
  "recommended_standard": "generic-project",
  "applicable_qa_patterns": ["verification_failure/build_failed", "safety_failure/insecure_default"],
  "risk_profile": "high",
  "threshold": 0.3,
  "signals": [
    { "type": "file_exists", "path": "go.mod", "weight": 3, "label": "go.mod" },
    { "type": "go_mod_contains", "pattern": "github.com/gin-gonic/gin", "weight": 4, "label": "dep:gin" },
    { "type": "go_mod_contains", "pattern": "github.com/labstack/echo", "weight": 4, "label": "dep:echo" },
    { "type": "go_mod_contains", "pattern": "github.com/gofiber/fiber", "weight": 4, "label": "dep:fiber" },
    { "type": "go_mod_contains", "pattern": "github.com/go-chi/chi", "weight": 3, "label": "dep:chi" },
    { "type": "file_glob", "pattern": "main.go", "weight": 2, "label": "main.go" },
    { "type": "file_glob", "pattern": "cmd/*/main.go", "weight": 2, "label": "cmd/*/main.go" },
    { "type": "lang_equals", "value": "go", "weight": 2, "label": "detected_language:go" }
  ]
}
