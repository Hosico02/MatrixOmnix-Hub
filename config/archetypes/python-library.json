{
  "id": "python-library",
  "name": "Python library / distributable package",
  "description": "Python package published as a library — has packaging metadata, exposes an importable API, no app/server entry point.",
  "recommended_standard": "python-package",
  "applicable_qa_patterns": [
    "verification_failure/test_failed",
    "project_structure_failure/missing_config",
    "test_quality_failure/empty_test"
  ],
  "risk_profile": "low",
  "threshold": 0.45,
  "signals": [
    { "type": "file_exists",        "path": "pyproject.toml",                                 "weight": 4, "label": "pyproject.toml" },
    { "type": "pyproject_contains", "pattern": "build-backend",                               "weight": 3, "label": "pyproject:build-backend (PEP 517)" },
    { "type": "pyproject_contains", "pattern": "classifiers",                                 "weight": 2, "label": "pyproject:classifiers" },
    { "type": "pyproject_contains", "pattern": "\\[project\\]|\\[tool\\.poetry\\]|\\[tool\\.setuptools\\]", "weight": 2, "label": "pyproject:[project]/[tool.poetry]/[tool.setuptools]" },
    { "type": "file_glob",          "pattern": "**/__init__.py",                              "weight": 2, "label": "<pkg>/__init__.py" },
    { "type": "lang_equals",        "value": "python",                                        "weight": 2, "label": "lang:python" },
    { "type": "framework_detected", "name": "flask",                                          "weight": -3, "label": "penalty:flask app" },
    { "type": "framework_detected", "name": "fastapi",                                        "weight": -3, "label": "penalty:fastapi app" },
    { "type": "framework_detected", "name": "django",                                         "weight": -3, "label": "penalty:django app" },
    { "type": "pyproject_contains", "pattern": "console_scripts",                             "weight": -2, "label": "penalty:console_scripts (CLI)" }
  ]
}
