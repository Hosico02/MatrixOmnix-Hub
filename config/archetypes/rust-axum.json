{
  "id": "rust-axum",
  "name": "Rust axum web server",
  "description": "Rust HTTP server using axum or warp",
  "recommended_standard": "generic-project",
  "applicable_qa_patterns": ["verification_failure/build_failed", "safety_failure/insecure_default"],
  "risk_profile": "high",
  "threshold": 0.35,
  "signals": [
    { "type": "file_exists", "path": "Cargo.toml", "weight": 3, "label": "Cargo.toml" },
    { "type": "cargo_dep", "dep": "axum", "weight": 4, "label": "dep:axum" },
    { "type": "cargo_dep", "dep": "warp", "weight": 3, "label": "dep:warp" },
    { "type": "cargo_dep", "dep": "actix-web", "weight": 3, "label": "dep:actix-web" },
    { "type": "cargo_dep", "dep": "tokio", "weight": 2, "label": "dep:tokio" },
    { "type": "file_glob", "pattern": "src/main.rs", "weight": 2, "label": "src/main.rs" },
    { "type": "lang_equals", "value": "rust", "weight": 2, "label": "detected_language:rust" }
  ]
}
