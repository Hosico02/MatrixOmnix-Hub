{
  "id": "rails-app",
  "name": "Ruby on Rails application",
  "description": "Ruby on Rails web application",
  "recommended_standard": "generic-project",
  "applicable_qa_patterns": ["verification_failure/build_failed", "safety_failure/insecure_default", "safety_failure/secret_leak"],
  "risk_profile": "high",
  "threshold": 0.3,
  "signals": [
    { "type": "file_exists", "path": "Gemfile", "weight": 3, "label": "Gemfile" },
    { "type": "file_exists", "path": "config.ru", "weight": 2, "label": "config.ru" },
    { "type": "gemfile_contains", "pattern": "\\brails\\b", "weight": 4, "label": "gem:rails" },
    { "type": "dir_exists", "path": "app/controllers", "weight": 3, "label": "app/controllers/" },
    { "type": "dir_exists", "path": "config/routes.rb", "weight": 2, "label": "config/routes.rb" },
    { "type": "file_exists", "path": "bin/rails", "weight": 2, "label": "bin/rails" }
  ]
}
